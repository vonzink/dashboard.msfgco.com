{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PlaudRecordingsArchive",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListBucket",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::msfg-plaud-recordings",
        "arn:aws:s3:::msfg-plaud-recordings/*"
      ]
    }
  ]
}
